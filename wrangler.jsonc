{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "laltrospazio-digital",
  "compatibility_date": "2026-08-13",
  "main": "worker/index.mjs",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  // Real production D1 database (region EEUR), created 2026-08-13. No
  // migration has been applied to it yet with --remote, and it is not yet
  // referenced by any deployed Worker version. See
  // docs/project/meta-integration-plan.md for the exact next-phase steps.
  "d1_databases": [
    {
      "binding": "META_DB",
      "database_name": "laltrospazio-meta",
      "database_id": "d3f2054c-2010-4dbc-9a4e-58d73a821c02",
      "migrations_dir": "./migrations"
    }
  ]
  // Intentionally no "triggers": { "crons": [...] } yet. Do not add a
  // production cron cadence until the scheduled handler has been proven with
  // `wrangler dev --test-scheduled` and an owner-approved cadence is chosen.
}
