{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "laltrospazio-digital",
  "compatibility_date": "2026-08-13",
  "main": "worker/index.mjs",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  // Real production D1 database (region EEUR), created 2026-08-13.
  // Verified read-only on 2026-08-19 with `wrangler d1 migrations list
  // laltrospazio-meta --remote`: "No migrations to apply" — the remote schema is
  // current, so 0001_create_meta_source_records.sql has been applied. Both
  // required secrets are installed (confirmed via `wrangler secret list`, names
  // only). The scheduled handler below therefore has the schema and credentials
  // it needs. See docs/project/meta-integration-plan.md for the wider plan.
  "d1_databases": [
    {
      "binding": "META_DB",
      "database_name": "laltrospazio-meta",
      "database_id": "d3f2054c-2010-4dbc-9a4e-58d73a821c02",
      "migrations_dir": "./migrations"
    }
  ],
  // Declares the two secret NAMES the scheduled handler requires
  // (worker/meta-scheduled.mjs requireMetaSecrets()). No value is ever set
  // here or in Git; values are installed only via `wrangler secret put`.
  "secrets": {
    "required": ["META_PAGE_ACCESS_TOKEN", "META_SYSTEM_USER_ACCESS_TOKEN"]
  },
  // Single daily production Cron: 05:17 UTC (Cloudflare Cron Triggers always
  // use UTC). Runs worker/index.mjs scheduled(), which reuses the proven
  // read-only dual-credential ingestion (Facebook via Page token, Instagram
  // via system-user token, one page / 100 records per network) and writes
  // only private candidate records to META_DB. To disable, set
  // "crons": [] and redeploy.
  "triggers": {
    "crons": ["17 5 * * *"]
  }
}
